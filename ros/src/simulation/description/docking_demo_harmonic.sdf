          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <link name="front_wheel">
        <pose relative_to="chassis">0.045 0 0 0 1.5707 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000066</ixx><iyy>0.000066</iyy><izz>0.000125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
