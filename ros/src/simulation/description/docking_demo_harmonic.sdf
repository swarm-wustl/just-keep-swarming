<?xml version="1.0"?>
<!--
  Scalable N-robot docking demo with differential drive using AttachablePlugin.

  Robots start DISCONNECTED. Use attach commands to connect them.

  Topic: /attach (gz.msgs.StringMsg)
  Attach: [model1][chassis][model2][chassis][attach]
  Detach: [model1][chassis][model2][chassis][detach]

  Velocity commands per robot:
    gz topic -t /model/robot_0/cmd_vel -m gz.msgs.Twist -p 'linear:{x:0.5}'
    gz topic -t /model/robot_1/cmd_vel -m gz.msgs.Twist -p 'linear:{x:0.5}'

  Test symmetric docking:
    1. Connect: gz topic -t /attach -m gz.msgs.StringMsg -p 'data:"[robot_0][chassis][robot_1][chassis][attach]"'
    2. Drive robot_1: gz topic -t /model/robot_1/cmd_vel -m gz.msgs.Twist -p 'linear:{x:0.3}'
    3. Both robots should move together!
-->
<sdf version="1.9">
  <world name="docking_demo">
    <!-- Physics configuration - ODE with soft constraints to prevent error accumulation -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>world</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <!-- Increase CFM for softer constraints (reduces error accumulation) -->
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Required system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- AttachablePlugin for dynamic symmetric docking -->
    <plugin filename="libattachable_joint_plugin.so"
            name="attachable_joint::AttachableJoint">
      <attachtopic>/attach</attachtopic>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== ROBOT 0 (Red) ========== -->
    <model name="robot_0" canonical_link="chassis">
      <pose>0 0 0.05 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00167</ixx>
            <iyy>0.00167</iyy>
            <izz>0.00167</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Left wheel -->
      <link name="left_wheel">
        <pose relative_to="chassis">0 0.06 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.002</slip1><slip2>0.002</slip2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <!-- Right wheel -->
      <link name="right_wheel">
        <pose relative_to="chassis">0 -0.06 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.002</slip1><slip2>0.002</slip2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>


      <!-- Dock port indicators -->
      <!-- Caster for stability -->
      <link name="caster">
        <pose relative_to="chassis">-0.04 0 -0.03 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>

      <link name="dock_front">
        <pose relative_to="chassis">0.05 0 0 0 0 0</pose>
        <inertial><mass>0.001</mass>
          <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.008</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
      <joint name="dock_front_joint" type="fixed"><parent>chassis</parent><child>dock_front</child></joint>

      <link name="dock_back">
        <pose relative_to="chassis">-0.05 0 0 0 0 0</pose>
        <inertial><mass>0.001</mass>
          <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.008</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
      <joint name="dock_back_joint" type="fixed"><parent>chassis</parent><child>dock_back</child></joint>

      <!-- Differential drive plugin -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.12</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <odom_publish_frequency>10</odom_publish_frequency>
        <cmd_timeout>10.0</cmd_timeout>
      </plugin>
    </model>

    <!-- ========== ROBOT 1 (Green) ========== -->
    <model name="robot_1" canonical_link="chassis">
      <pose>0.25 0 0.05 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00167</ixx>
            <iyy>0.00167</iyy>
            <izz>0.00167</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose relative_to="chassis">0 0.06 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.002</slip1><slip2>0.002</slip2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <link name="right_wheel">
        <pose relative_to="chassis">0 -0.06 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.002</slip1><slip2>0.002</slip2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <!-- Caster for stability -->
      <link name="caster">
        <pose relative_to="chassis">-0.04 0 -0.03 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>

      <link name="dock_front">
        <pose relative_to="chassis">0.05 0 0 0 0 0</pose>
        <inertial><mass>0.001</mass>
          <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.008</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
      <joint name="dock_front_joint" type="fixed"><parent>chassis</parent><child>dock_front</child></joint>

      <link name="dock_back">
        <pose relative_to="chassis">-0.05 0 0 0 0 0</pose>
        <inertial><mass>0.001</mass>
          <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.008</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
      <joint name="dock_back_joint" type="fixed"><parent>chassis</parent><child>dock_back</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.12</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <odom_publish_frequency>10</odom_publish_frequency>
      </plugin>
    </model>

    <!-- ========== ROBOT 2 (Blue) ========== -->
    <model name="robot_2" canonical_link="chassis">
      <pose>0.50 0 0.05 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00167</ixx>
            <iyy>0.00167</iyy>
            <izz>0.00167</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
