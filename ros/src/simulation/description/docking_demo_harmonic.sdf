<?xml version="1.0"?>
<!--
  Modular robot docking demo with realistic dimensions and IMU sensors.

  Robot specs:
    - Overall footprint: 10x10x10 cm
    - Chassis: 8x8x8 cm
    - Drive wheels (left/right): 10cm diameter, 1cm thick, dark gray
    - Support wheels (front/back): 10cm diameter, 1cm thick, chassis color, frictionless
    - IMU: 100Hz update rate with realistic noise

  Topics:
    /attach - Attach/detach commands (gz.msgs.StringMsg)
    /model/robot_N/cmd_vel - Velocity commands (gz.msgs.Twist)
    /world/docking_demo/model/robot_N/link/imu_link/sensor/imu_sensor/imu - IMU data
-->
<sdf version="1.9">
  <world name="docking_demo">
    <!-- Physics configuration - ODE with soft constraints -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>world</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Required system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>

    <!-- AttachablePlugin for dynamic docking -->
    <plugin filename="libattachable_joint_plugin.so" name="attachable_joint::AttachableJoint">
      <attachtopic>/attach</attachtopic>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ==================== ENVIRONMENT ==================== -->
    <!--
      Environment layout (top-down, Y+ is forward):

      +===============================+  y = 2.2m
      |         END ZONE              |
      |                               |
      +===+---------------------------+  y = 1.7m
          |  narrow wall (turn req.)  |
      +---+                           +  y = 1.6m
      |12cm                           |
      | gap   MIDDLE PLATFORM         |
      |       (docking area)          |
      +===============================+  y = 0.9m
      |                               |
      |       GAP (20cm chasm)        |  <- Robots must chain to cross
      |                               |
      +===============================+  y = 0.7m
      |                               |
      |       START ZONE              |
      |       (robots spawn)          |
      +===============================+  y = 0.0m
      x=0                          x=1.2m

      Key challenges:
      1. 20cm gap (y=0.7-0.9): robots must form chain to bridge
      2. 12cm passage on LEFT (x=0-0.12): requires turn, robots must detach
    -->

    <!-- Ground plane - visual only, no collision (platforms provide collision) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start platform (solid ground before the gap) - enlarged for docking -->
    <!-- y spans 0 to 0.7 (70cm deep) -->
    <model name="start_platform">
      <static>true</static>
      <pose>0.6 0.35 -0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.7 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.05</size></box></geometry>
          <material>
            <ambient>0.3 0.5 0.3 1</ambient>
            <diffuse>0.3 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Middle platform (after the gap, before narrow passage) - enlarged for docking -->
    <!-- y spans 0.9 to 1.6 (70cm deep) -->
    <model name="middle_platform">
      <static>true</static>
      <pose>0.6 1.25 -0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.7 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.05</size></box></geometry>
          <material>
            <ambient>0.3 0.5 0.3 1</ambient>
            <diffuse>0.3 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- End platform (after narrow passage) -->
    <!-- y spans 1.7 to 2.2 -->
    <model name="end_platform">
      <static>true</static>
      <pose>0.6 1.95 -0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.5 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.5 0.05</size></box></geometry>
          <material>
            <ambient>0.5 0.3 0.3 1</ambient>
            <diffuse>0.5 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- GAP/CHASM: 20cm wide (y=0.7 to y=0.9) - robots must form chain to cross -->
    <!-- Visual indicator for the chasm (dark pit) -->
    <model name="chasm_visual">
      <static>true</static>
      <pose>0.6 0.8 -0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 0.2 0.3</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- NARROW PASSAGE: 12cm gap on LEFT side - requires turn to navigate -->
    <!-- Gap is from x=0 to x=0.12, wall covers x=0.12 to x=1.2 -->
    <model name="narrow_wall">
      <static>true</static>
      <pose>0.66 1.65 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.08 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.08 0.1 0.1</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.5 1</ambient>
            <diffuse>0.4 0.4 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Gap on left: x = 0 to 0.12 (12cm wide) - robots must turn left to pass -->

    <!-- PERIMETER WALLS -->
    <!-- Left wall (x=0) -->
    <model name="wall_left">
      <static>true</static>
      <pose>-0.025 1.1 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 2.3 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 2.3 0.1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right wall (x=1.2) -->
    <model name="wall_right">
      <static>true</static>
      <pose>1.225 1.1 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 2.3 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 2.3 0.1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Back wall (y=0) -->
    <model name="wall_back">
      <static>true</static>
      <pose>0.6 -0.025 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.3 0.05 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.3 0.05 0.1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Front wall (y=2.2) -->
    <model name="wall_front">
      <static>true</static>
      <pose>0.6 2.225 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.3 0.05 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.3 0.05 0.1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== ROBOTS ==================== -->
    <!-- Robots start on the start platform (x=0-1.2, y=0-0.7) -->

    <!-- ========== ROBOT 0 (Red) ========== -->
    <model name="robot_0" canonical_link="chassis">
      <pose>0.30 0.20 0.05 0 0 0</pose>

      <!-- Chassis: 8x8x8 cm -->
      <link name="chassis">
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.000853</ixx><iyy>0.000853</iyy><izz>0.000853</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Left drive wheel -->
      <link name="left_wheel">
        <pose relative_to="chassis">0 0.045 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000066</ixx><iyy>0.000066</iyy><izz>0.000125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.005</slip1><slip2>0.005</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <!-- Right drive wheel -->
      <link name="right_wheel">
        <pose relative_to="chassis">0 -0.045 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000066</ixx><iyy>0.000066</iyy><izz>0.000125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.005</slip1><slip2>0.005</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <!-- Front support wheel (docking face) - perpendicular, frictionless -->
      <link name="front_wheel">
        <pose relative_to="chassis">0.045 0 0 0 1.5707 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000066</ixx><iyy>0.000066</iyy><izz>0.000125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="front_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_wheel</child>
        <axis>
          <xyz expressed_in="__model__">1 0 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <!-- Back support wheel (docking face) - perpendicular, frictionless -->
      <link name="back_wheel">
        <pose relative_to="chassis">-0.045 0 0 0 1.5707 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000066</ixx><iyy>0.000066</iyy><izz>0.000125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="back_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>back_wheel</child>
        <axis>
          <xyz expressed_in="__model__">1 0 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <!-- IMU sensor -->
      <link name="imu_link">
        <pose relative_to="chassis">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>100</update_rate>
          <visualize>false</visualize>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>
      <joint name="imu_joint" type="fixed">
        <parent>chassis</parent>
        <child>imu_link</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.09</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <odom_publish_frequency>10</odom_publish_frequency>
        <cmd_timeout>10.0</cmd_timeout>
      </plugin>
    </model>

    <!-- ========== ROBOT 1 (Green) ========== -->
    <model name="robot_1" canonical_link="chassis">
      <pose>0.60 0.20 0.05 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.000853</ixx><iyy>0.000853</iyy><izz>0.000853</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose relative_to="chassis">0 0.045 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000066</ixx><iyy>0.000066</iyy><izz>0.000125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.005</slip1><slip2>0.005</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <link name="right_wheel">
        <pose relative_to="chassis">0 -0.045 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000066</ixx><iyy>0.000066</iyy><izz>0.000125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.005</slip1><slip2>0.005</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <link name="front_wheel">
        <pose relative_to="chassis">0.045 0 0 0 1.5707 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000066</ixx><iyy>0.000066</iyy><izz>0.000125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="front_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_wheel</child>
        <axis>
          <xyz expressed_in="__model__">1 0 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <link name="back_wheel">
        <pose relative_to="chassis">-0.045 0 0 0 1.5707 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
